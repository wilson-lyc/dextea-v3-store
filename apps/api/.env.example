# 运行环境：development | test | production
NODE_ENV=development

# 服务
PORT=8296
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8295
CORS_CREDENTIALS=true
LOG_LEVEL=info

# 数据库连接配置仍由基础设施模块保留；Store API 门店领域读写统一走 RPC。
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 门店领域微服务（Nacos 与固定地址二选一；固定地址为 gRPC host:port）
STORE_SERVICE_NAME=dextea-store-service
STORE_SERVICE_SCHEME=http
STORE_SERVICE_ADDR=127.0.0.1:9092
# 分面 RPC token；本地鉴权关闭时可留空
STORE_ADMIN_SERVICE_TOKEN=
STORE_CREDENTIAL_SERVICE_TOKEN=
PRODUCT_SERVICE_ADDR=127.0.0.1:9090
PRODUCT_SERVICE_NAME=dextea-product
PRODUCT_ADMIN_SERVICE_TOKEN=
PRODUCT_BUSINESS_SERVICE_TOKEN=

# 订单微服务（Nacos与固定地址二选一）
ORDER_SERVICE_PROTOCOL=rpc
# 使用 Nacos 服务发现（推荐）
ORDER_SERVICE_NAME=dextea-trade
ORDER_SERVICE_SCHEME=http
ORDER_SERVICE_RPC_ADDR=127.0.0.1:9091
# 使用固定地址
# ORDER_SERVICE_BASE_URL=http://localhost:8300

# Nacos
NACOS_ENABLED=true
# 多个地址用逗号分隔
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
# 限定集群，留空表示不限
NACOS_CLUSTER=
NACOS_USERNAME=
NACOS_PASSWORD=

# 订单状态 MQ（单个消费者监听 PENDING_TO_PREPARING 与 PREPARING_TO_READY 两种 tag）
ORDER_MAKING_MQ_ENABLED=false
ORDER_MAKING_MQ_ENDPOINTS=
ORDER_MAKING_MQ_NAMESPACE=
ORDER_MAKING_MQ_ACCESS_KEY=
ORDER_MAKING_MQ_SECRET_KEY=
ORDER_MAKING_MQ_TOPIC=
ORDER_MAKING_MQ_CONSUMER_GROUP=
