# 运行环境：development | test | production
NODE_ENV=development

# 服务
PORT=8296
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8195
CORS_CREDENTIALS=true
LOG_LEVEL=info

# 数据库（必填）
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT（必填，生产环境至少 16 位）
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 订单微服务
# Nacos 服务发现未启用时必填；启用后订单服务地址从 Nacos 解析，此项被忽略
ORDER_SERVICE_BASE_URL=http://localhost:8300
# Nacos 中注册的服务名（启用服务发现后生效）
ORDER_SERVICE_NAME=order-service
# 实例元数据未声明 scheme 时使用的协议
ORDER_SERVICE_SCHEME=http

# ===== Nacos 服务注册与发现（仅启用服务发现，不使用配置中心） =====
NACOS_ENABLED=false
# 多个地址用逗号分隔，例如 10.0.0.1:8848,10.0.0.2:8848
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
# 限定集群，留空表示不限
NACOS_CLUSTERS=
NACOS_USERNAME=
NACOS_PASSWORD=

# ===== 制单 MQ =====
ORDER_MAKING_MQ_ENABLED=false
ORDER_MAKING_MQ_ENDPOINTS=
ORDER_MAKING_MQ_NAMESPACE=
ORDER_MAKING_MQ_ACCESS_KEY=
ORDER_MAKING_MQ_SECRET_KEY=
ORDER_MAKING_MQ_TOPIC=
ORDER_MAKING_MQ_CONSUMER_GROUP=
