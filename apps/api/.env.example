# 运行环境：development | test | production
NODE_ENV=development

# 服务
PORT=8296
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8195
CORS_CREDENTIALS=true
LOG_LEVEL=info

# 数据库
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 订单微服务（Nacos与固定地址二选一）
# 使用 Nacos 服务发现（推荐）
ORDER_SERVICE_NAME=dextea-order-service
ORDER_SERVICE_SCHEME=http
# 使用固定地址
# ORDER_SERVICE_BASE_URL=http://localhost:8300

# Nacos
NACOS_ENABLED=true
# 多个地址用逗号分隔
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
# 限定集群，留空表示不限
NACOS_CLUSTERS=
NACOS_USERNAME=
NACOS_PASSWORD=

# 制单 MQ
ORDER_MAKING_MQ_ENABLED=false
ORDER_MAKING_MQ_ENDPOINTS=
ORDER_MAKING_MQ_NAMESPACE=
ORDER_MAKING_MQ_ACCESS_KEY=
ORDER_MAKING_MQ_SECRET_KEY=
ORDER_MAKING_MQ_TOPIC=
ORDER_MAKING_MQ_CONSUMER_GROUP=
